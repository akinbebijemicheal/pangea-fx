# HTTP port the API listens on
PORT=3000
NODE_ENV=development

# Postgres connection string for running the API on the host against the compose db
# (published on host port 5433). docker compose sets its own value for the api container.
DATABASE_URL=postgres://pangea:pangea@localhost:5433/pangea_fx

# Run pending migrations when the API starts (true/false)
DB_MIGRATE_ON_BOOT=true

# FX rates: live provider, cache TTL, request timeout and retry backoff after a failure
FX_PROVIDER_URL=https://open.er-api.com/v6/latest/USD
FX_CACHE_TTL_SECONDS=3600
FX_TIMEOUT_MS=3000
FX_RETRY_BACKOFF_SECONDS=60

# Scheduled FX refresh (cron, UTC; "off" to disable) and a background refresh at startup
FX_REFRESH_CRON=10 0 * * *
FX_REFRESH_ON_BOOT=true

# Idempotency: key retention, cleanup schedule (cron, UTC; "off" to disable) and how long
# a duplicate waits for the in-flight original before getting 409
IDEMPOTENCY_KEY_TTL_HOURS=24
IDEMPOTENCY_CLEANUP_CRON=15 * * * *
IDEMPOTENCY_LOCK_TIMEOUT_MS=5000
