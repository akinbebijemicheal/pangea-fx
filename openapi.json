      "PaginationDto": {
        "type": "object",
        "properties": {
          "limit": {
            "type": "number",
            "example": 10,
            "description": "Page size used for this response"
          },
          "totalCount": {
            "type": "number",
            "example": 42,
            "description": "Transactions matching the filters, across all pages"
          },
          "totalPages": {
            "type": "number",
            "example": 5,
            "description": "ceil(totalCount / limit); 0 when there are none"
          },
          "hasMore": {
            "type": "boolean",
            "description": "Whether another page follows this one"
          }
        },
        "required": [
          "limit",
          "totalCount",
          "totalPages",
          "hasMore"
        ]
      },
      "CountByTypeDto": {
        "type": "object",
        "properties": {
          "deposit": {
            "type": "number",
            "example": 3
          },
          "swap": {
            "type": "number",
            "example": 2
          },
          "transfer": {
            "type": "number",
            "example": 4
          }
        },
        "required": [
          "deposit",
          "swap",
          "transfer"
        ]
      },
      "CurrencyTotalDto": {
        "type": "object",
        "properties": {
          "currency": {
            "type": "string",
            "enum": [
              "cNGN",
              "cGHS",
              "cXAF",
              "USDx",
              "EURx"
            ],
            "example": "USDx"
          },
          "amount": {
            "type": "string",
            "example": "120.00000000",
            "description": "Exact total, 8 dp decimal string"
          },
          "usdValue": {
            "type": "string",
            "example": "120.00000000",
            "description": "USD equivalent at current rates, rounded down to 8 dp"
          }
        },
        "required": [
          "currency",
          "amount",
          "usdValue"
        ]
      },
      "HistorySummaryDto": {
        "type": "object",
        "properties": {
          "transactionCount": {
            "type": "number",
            "example": 9,
            "description": "Transactions matching the filters"
          },
          "countByType": {
            "$ref": "#/components/schemas/CountByTypeDto"
          },
          "debits": {
            "description": "Total debited from this wallet per currency (transfers sent, the sold side of swaps). One entry per supported currency.",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CurrencyTotalDto"
            }
          },
          "credits": {
            "description": "Total credited to this wallet per currency (deposits, transfers received, the bought side of swaps). One entry per supported currency.",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CurrencyTotalDto"
            }
          },
          "totalDebitUsd": {
            "type": "string",
            "example": "120.00000000",
            "description": "Sum of debits[].usdValue"
          },
          "totalCreditUsd": {
            "type": "string",
            "example": "600.33333333",
            "description": "Sum of credits[].usdValue"
          },
          "netUsd": {
            "type": "string",
            "example": "480.33333333",
            "description": "totalCreditUsd - totalDebitUsd (negative when more went out than came in)"
          },
          "valuation": {
            "description": "The rates used for the USD values: current rates, not historical ones",
            "allOf": [
              {
                "$ref": "#/components/schemas/ValuationDto"
              }
            ]
          }
        },
        "required": [
          "transactionCount",
          "countByType",
          "debits",
          "credits",
          "totalDebitUsd",
          "totalCreditUsd",
          "netUsd",
          "valuation"
        ]
      },
      "WalletTransactionsPageDto": {
        "type": "object",
        "properties": {
          "data": {
            "description": "Newest first",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/WalletTransactionDto"
            }
          },
          "nextCursor": {
            "type": "string",
            "nullable": true,
            "description": "Pass as `cursor` to get the next page; null when there are no more"
          },
          "pagination": {
            "$ref": "#/components/schemas/PaginationDto"
          },
          "summary": {
            "description": "Analytics over every transaction matching the filters (all pages, not just this one). Read from running aggregates, so its cost does not grow with history length.",
            "allOf": [
              {
                "$ref": "#/components/schemas/HistorySummaryDto"
              }
            ]
          }
        },
        "required": [
          "data",
          "nextCursor",
          "pagination",
          "summary"
        ]
      },
      "CreateSwapDto": {
        "type": "object",
        "properties": {
          "fromCurrency": {
            "type": "string",
            "enum": [
              "cNGN",
              "cGHS",
              "cXAF",
              "USDx",
              "EURx"
            ],
            "example": "USDx",
            "description": "Currency to sell"
          },
          "toCurrency": {
            "type": "string",
            "enum": [
              "cNGN",
              "cGHS",
              "cXAF",
              "USDx",
              "EURx"
            ],
            "example": "cNGN",
            "description": "Currency to buy"
          },
          "amount": {
            "type": "string",
            "example": "100.00",
            "description": "Amount of fromCurrency to sell. Positive decimal string, at most 8 decimal places. The amount received is amount x rate, rounded down to 8 dp."
          }
        },
        "required": [
          "fromCurrency",
          "toCurrency",
          "amount"
        ]
      },
      "CreateTransferDto": {
        "type": "object",
        "properties": {
          "toWalletId": {
            "type": "string",
            "format": "uuid",
            "description": "Receiving wallet"
          },
          "fromCurrency": {
            "type": "string",
            "enum": [
              "cNGN",
              "cGHS",
              "cXAF",
              "USDx",
              "EURx"
            ],
            "example": "USDx",
            "description": "Currency debited from the sender"
          },
          "toCurrency": {
            "type": "string",
            "enum": [
              "cNGN",
              "cGHS",
              "cXAF",
              "USDx",
              "EURx"
            ],
            "example": "cNGN",
            "description": "Currency credited to the receiver. Defaults to fromCurrency; when different, the amount is converted at the current stored rate."
          },
          "amount": {
            "type": "string",
            "example": "100.00",
            "description": "Amount debited from the sender, in fromCurrency. Positive decimal string, at most 8 decimal places. The receiver gets amount x rate, rounded down to 8 dp."
          }
        },
        "required": [
          "toWalletId",
          "fromCurrency",
          "amount"
        ]
      }
    }
  }
